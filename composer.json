{
    "name": "slothsoft/slothsoft.net",
    "type": "project",
    "description": "slothsoft.net",
    "license": "MIT",
    "keywords": [
        "slothsoft",
        "farah-module",
        "farah-server"
    ],
    "autoload": {
        "files": [
            "src/bootstrap.php"
        ],
        "psr-4": {
            "Slothsoft\\Server\\Slothsoft\\": "src"
        }
    },
    "require": {
        "slothsoft/amber": "1.1.17",
        "slothsoft/chat": "^1.1.4",
        "slothsoft/core": "^1.14.27",
        "slothsoft/farah": "^1.29.0",
        "slothsoft/minecraft": "^1.0.9",
        "slothsoft/sse": "^1.10.16"
    },
    "require-dev": {
        "phpunit/phpunit": "~9.6.34",
        "slothsoft/farah-testing": "^1.3.13"
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ],
        "psr-4": {
            "Slothsoft\\Server\\Slothsoft\\": "tests"
        }
    },
    "scripts": {
        "farah-asset": "@php vendor/slothsoft/farah/scripts/farah-asset.php",
        "farah-page": "@php vendor/slothsoft/farah/scripts/farah-page.php"
    },
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "homepage": "https://slothsoft.net",
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
