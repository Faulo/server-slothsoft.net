{
    "name": "slothsoft/slothsoft.net",
    "type": "project",
    "description": "slothsoft.net",
    "license": "MIT",
    "keywords": [
        "slothsoft",
        "farah-module",
        "farah-server"
    ],
    "autoload": {
        "files": [
            "src/bootstrap.php"
        ],
        "psr-4": {
            "Slothsoft\\Server\\Slothsoft\\": "src"
        }
    },
    "require": {
        "ext-dom": "*",
        "slothsoft/amber": "1.1.17",
        "slothsoft/chat": "^1.1.7",
        "slothsoft/core": "^1.15.1",
        "slothsoft/farah": "^1.29.7",
        "slothsoft/minecraft": "^1.0.9",
        "slothsoft/final-fantasy": "dev-main",
        "slothsoft/savegame": "dev-main",
        "slothsoft/sse": "^1.11.3"
    },
    "repositories": [
        {
            "type": "git",
            "url": "https://github.com/Faulo/slothsoft-final-fantasy"
        }
    ],
    "require-dev": {
        "phpstan/phpstan": "^2.3.4",
        "phpunit/phpunit": "~9.6.34",
        "slothsoft/farah-testing": "^1.3.14"
    },
    "autoload-dev": {
        "classmap": [
            "tests/"
        ],
        "psr-4": {
            "Slothsoft\\Server\\Slothsoft\\": "tests"
        }
    },
    "scripts": {
        "farah-asset": "@php vendor/slothsoft/farah/scripts/farah-asset.php",
        "farah-page": "@php vendor/slothsoft/farah/scripts/farah-page.php"
    },
    "authors": [
        {
            "name": "Daniel Schulz",
            "email": "info.slothsoft@gmail.com"
        }
    ],
    "homepage": "https://slothsoft.net",
    "config": {
        "platform": {
            "php": "8.2"
        }
    }
}
